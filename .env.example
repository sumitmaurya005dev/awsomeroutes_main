# Supabase public browser/server configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase key. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-only ImageKit credentials
IMAGEKIT_PUBLIC_KEY=public_replace_me
IMAGEKIT_PRIVATE_KEY=private_replace_me
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Supabase public browser/server configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Server-only Supabase key. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key

# Server-only ImageKit credential used by authenticated upload routes
IMAGEKIT_PRIVATE_KEY=replace-with-imagekit-private-key

# Exact trusted admin portal origin. HTTPS and non-local in production.
APP_ORIGIN=https://portal.awesomeroutes.com

# Optional local end-to-end test configuration (not required in production)
ITINERARY_QA_OUTPUT=replace-with-local-output-directory
PLAYWRIGHT_CHANNEL=replace-with-browser-channel

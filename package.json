{
  "name": "awesomeroutes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:activity && npm run test:hotel && npm run test:vehicle && npm run test:package && npm run test:location && npm run test:itinerary && npm run test:sidebar",
    "test:sidebar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/sidebar-navigation.test.mjs",
    "test:itinerary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/custom-itinerary-pricing.test.mjs tests/custom-itinerary-database.test.mjs tests/custom-itinerary-pdf.test.mjs",
    "test:itinerary:ui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/custom-itinerary-ui.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:activity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/activity-pricing.test.mjs",
    "test:hotel": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/hotel-pricing.test.mjs tests/hotel-security.test.mjs",
    "test:vehicle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/vehicle-pricing.test.mjs tests/vehicle-security.test.mjs",
    "test:package": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/package-pricing.test.mjs tests/package-security.test.mjs",
    "test:location": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/location-delete.test.mjs"
  },
